// 모모네 집 가계부 · Google Apps Script
// 최초 설정: setupLedger를 실행한 뒤 웹 앱을 '웹 앱에 액세스하는 사용자'로 배포합니다.
function setupLedger() {
  const props = PropertiesService.getScriptProperties();
  const email = Session.getEffectiveUser().getEmail().toLowerCase();
  if (!email) throw new Error('구글 계정으로 로그인해 주세요.');
  if (props.getProperty('SPREADSHEET_ID')) return '이미 설정되어 있습니다.';
  const ss = SpreadsheetApp.create('모모네 집 가계부 · 공동 저장');
  const sheet = ss.getSheets()[0]; sheet.setName('거래내역');
  sheet.appendRow(['id','owner','type','date','category','subcategory','description','amount','payment','memo']);
  const meta = ss.insertSheet('월별상태'); meta.appendRow(['연월','업로드입력자','확정','수정일']);
  props.setProperties({SPREADSHEET_ID:ss.getId(),ACCOUNTS:JSON.stringify({[email]:'토끼'}),ADMIN_EMAIL:email,REVISION:'0'});
  return ss.getUrl();
}
function doGet() { requireAccount_(); return HtmlService.createHtmlOutputFromFile('Index').setTitle('모모네 집 가계부').addMetaTag('viewport','width=device-width, initial-scale=1'); }
function requireAccount_() {
  const p=PropertiesService.getScriptProperties(), email=Session.getActiveUser().getEmail().toLowerCase();
  if(!email)throw new Error('구글 로그인 후 접속해 주세요. 웹 앱은 접속한 사용자 권한으로 실행해야 합니다.');
  const accounts=JSON.parse(p.getProperty('ACCOUNTS')||'{}');
  if(!accounts[email])throw new Error('공동 가계부에 등록되지 않은 계정입니다.');
  return {email,owner:accounts[email],admin:email===p.getProperty('ADMIN_EMAIL')};
}
function ss_(){const id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw new Error('먼저 setupLedger를 실행해 주세요.');return SpreadsheetApp.openById(id);}
function readState_(){const ss=ss_(), rows=ss.getSheetByName('거래내역').getDataRange().getValues(), records=rows.slice(1).filter(r=>r[0]).map(r=>({id:String(r[0]),owner:String(r[1]),type:String(r[2]),date:String(r[3]),category:String(r[4]),subcategory:String(r[5]),description:String(r[6]),amount:Number(r[7]),payment:String(r[8]),memo:String(r[9])})),months={};ss.getSheetByName('월별상태').getDataRange().getValues().slice(1).filter(r=>r[0]).forEach(r=>months[String(r[0])]={uploaded:JSON.parse(r[1]),confirmed:r[2]===true||r[2]==='TRUE',updatedAt:String(r[3])});return {records,months,revision:Number(PropertiesService.getScriptProperties().getProperty('REVISION')||0)};}
function loadLedger(){const user=requireAccount_(),lock=LockService.getScriptLock();lock.waitLock(30000);try{return {...readState_(),user}}finally{lock.releaseLock()}}
function validate_(records){if(!Array.isArray(records))throw new Error('내역 형식 오류');const ids={};return records.map(r=>{if(!r||!['토끼','캥거루'].includes(r.owner)||!['수입','지출'].includes(r.type)||!/^\d{4}-\d{2}-\d{2}$/.test(r.date)||typeof r.amount!=='number'||!isFinite(r.amount))throw new Error('내역 형식 오류');const parts=r.date.split('-').map(Number),d=new Date(Date.UTC(parts[0],parts[1]-1,parts[2]));if(d.getUTCFullYear()!==parts[0]||d.getUTCMonth()+1!==parts[1]||d.getUTCDate()!==parts[2])throw new Error('날짜 오류');if(ids[r.id])throw new Error('중복 내역 식별자');ids[r.id]=true;return {id:String(r.id||Utilities.getUuid()),owner:r.owner,type:r.type,date:r.date,category:String(r.category||'미분류'),subcategory:String(r.subcategory||''),description:String(r.description||''),amount:r.amount,payment:String(r.payment||''),memo:String(r.memo||'')};});}
function mutateLedger(op){const user=requireAccount_(),lock=LockService.getScriptLock();lock.waitLock(30000);try{const state=readState_();let records=state.records,months=state.months;const ensure=key=>months[key]||(months[key]={uploaded:[],confirmed:false,updatedAt:''});if(op.kind!=='import'&&Number(op.revision)!==state.revision)throw new Error('다른 사람이 먼저 저장했어요. 최신 내용을 불러왔으니 다시 시도해 주세요.');if(op.kind==='import'){const seen={};if(!Array.isArray(op.items)||!op.items.length)throw new Error('가져올 파일이 없습니다.');op.items.forEach(item=>{if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(item.period)||!['토끼','캥거루'].includes(item.owner))throw new Error('연월·입력자 오류');if(!user.admin&&item.owner!==user.owner)throw new Error('본인의 파일만 가져올 수 있어요.');const key=item.period+'|'+item.owner;if(seen[key])throw new Error('같은 월·입력자 파일 중복');seen[key]=true;const m=ensure(item.period);if(m.confirmed)throw new Error(item.period+'는 확정되어 있습니다. 먼저 확정을 해제하세요.');const imported=validate_(item.records);if(!imported.length||imported.some(r=>r.owner!==item.owner||r.date.slice(0,7)!==item.period))throw new Error('파일과 연월·입력자가 일치하지 않습니다.');records=records.filter(r=>!(r.date.slice(0,7)===item.period&&r.owner===item.owner)).concat(imported);m.uploaded=Array.from(new Set(m.uploaded.concat([item.owner])));m.confirmed=['토끼','캥거루'].every(o=>m.uploaded.includes(o));m.updatedAt=new Date().toISOString();});}else if(op.kind==='edit'){const old=records.find(r=>r.id===op.record.id);if(!old)throw new Error('내역이 없습니다.');if(!user.admin&&old.owner!==user.owner)throw new Error('본인의 내역만 수정할 수 있어요.');const changed=validate_([op.record])[0];if(changed.owner!==old.owner||changed.date.slice(0,7)!==old.date.slice(0,7))throw new Error('입력자와 월은 수정할 수 없습니다. 파일 가져오기로 변경해 주세요.');if(ensure(old.date.slice(0,7)).confirmed)throw new Error('먼저 확정을 해제해 주세요.');records=records.map(r=>r.id===old.id?changed:r);ensure(old.date.slice(0,7)).updatedAt=new Date().toISOString();}else if(op.kind==='deleteRecord'){const old=records.find(r=>r.id===op.id);if(!old)throw new Error('삭제할 내역이 없습니다.');if(!user.admin&&old.owner!==user.owner)throw new Error('본인의 내역만 삭제할 수 있어요.');records=records.filter(r=>r.id!==op.id);const m=ensure(old.date.slice(0,7));m.uploaded=(m.uploaded||[]).filter(o=>o!==old.owner);m.confirmed=false;m.updatedAt=new Date().toISOString();}else if(op.kind==='deleteOwner'){if(!['토끼','캥거루'].includes(op.owner))throw new Error('입력자 오류');if(!/^\d{4}-(0[1-9]|1[0-2])$/.test(op.period))throw new Error('삭제할 연월을 선택해 주세요.');if(!user.admin&&op.owner!==user.owner)throw new Error('본인의 내역만 삭제할 수 있어요.');const affected=records.filter(r=>r.owner===op.owner&&r.date.slice(0,7)===op.period);if(!affected.length)throw new Error(op.period+' '+op.owner+' 내역이 없습니다.');records=records.filter(r=>!(r.owner===op.owner&&r.date.slice(0,7)===op.period));const m=ensure(op.period);m.uploaded=(m.uploaded||[]).filter(o=>o!==op.owner);m.confirmed=false;m.updatedAt=new Date().toISOString();}else if(op.kind==='reopen'){ensure(op.period).confirmed=false;ensure(op.period).updatedAt=new Date().toISOString();}else if(op.kind==='confirm'){const m=ensure(op.period);if(!['토끼','캥거루'].every(o=>m.uploaded.includes(o)))throw new Error('두 사람의 업로드가 필요합니다.');m.confirmed=true;m.updatedAt=new Date().toISOString();}else throw new Error('지원하지 않는 작업입니다.');validate_(records);writeState_({records,months,revision:state.revision+1});return {records,months,revision:state.revision+1,user};}finally{lock.releaseLock()}}
function writeState_(state){const ss=ss_(),sheet=ss.getSheetByName('거래내역'),meta=ss.getSheetByName('월별상태');if(sheet.getLastRow()>1)sheet.getRange(2,1,sheet.getLastRow()-1,10).clearContent();if(state.records.length){if(sheet.getMaxRows()<state.records.length+1)sheet.insertRowsAfter(sheet.getMaxRows(),state.records.length+1-sheet.getMaxRows());sheet.getRange(2,1,state.records.length,10).setNumberFormat('@');const safe=v=>/^[=+@]/.test(String(v))?"'"+v:v;sheet.getRange(2,1,state.records.length,10).setValues(state.records.map(r=>[r.id,r.owner,r.type,r.date,r.category,r.subcategory,r.description,r.amount,r.payment,r.memo].map((v,i)=>i===7?v:safe(v))));sheet.getRange(2,8,state.records.length,1).setNumberFormat('#,##0');}if(meta.getLastRow()>1)meta.getRange(2,1,meta.getLastRow()-1,4).clearContent();const entries=Object.entries(state.months);if(entries.length){if(meta.getMaxRows()<entries.length+1)meta.insertRowsAfter(meta.getMaxRows(),entries.length+1-meta.getMaxRows());meta.getRange(2,1,entries.length,4).setNumberFormat('@');meta.getRange(2,1,entries.length,4).setValues(entries.map(([key,m])=>[key,JSON.stringify(m.uploaded),String(m.confirmed?'TRUE':'FALSE'),m.updatedAt]));}SpreadsheetApp.flush();PropertiesService.getScriptProperties().setProperty('REVISION',String(state.revision));}
// 편집기에서 이 함수의 이메일을 변경하고 한 번 실행하면 캥거루 계정을 등록합니다.
function addKangarooAccount(){const kangarooEmail='REPLACE_WITH_KANGAROO_EMAIL';if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(kangarooEmail))throw new Error('캥거루 이메일을 먼저 입력해 주세요.');const p=PropertiesService.getScriptProperties();if(Session.getEffectiveUser().getEmail().toLowerCase()!==p.getProperty('ADMIN_EMAIL'))throw new Error('관리자만 등록 가능합니다.');const accounts=JSON.parse(p.getProperty('ACCOUNTS')||'{}');accounts[kangarooEmail.toLowerCase()]='캥거루';p.setProperty('ACCOUNTS',JSON.stringify(accounts));return '계정 등록 완료. 저장용 Google Sheets를 이 계정에 편집자로 공유해 주세요.';}
